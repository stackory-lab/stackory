{
	"extends": "@stackory/tsconfig-presets/lib.esm.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "./dist/esm",
		"rootDir": "./src",
		"tsBuildInfoFile": "./dist/esm/.tsbuildinfo",
		"lib": ["ESNext"],
		"types": ["@stackory/web-global-types"]
	},
	"include": ["./src"],
	"exclude": ["node_modules", "dist", "**/*spec.ts", "**/*test.ts"]
}
