{
  "name": "@stackory/auth-core",
  "version": "1.0.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf ./dist && tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
    "clean": "rimraf ./node_modules dist",
    "check:lint": "biome check --write",
    "check:test": "vitest --watch=false",
    "check:type": "tsc -p ./tsconfig.esm.json --noEmit",
    "check:dep": "depcruise --config .dependency-cruiser.mjs src"
  },
  "dependencies": {
    "@stackory/contracts": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stackory-lab/stackory",
    "directory": "packages/auth/core"
  }
}