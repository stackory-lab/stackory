{
  "name": "@stackory/backend-utils",
  "version": "0.0.1",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
    "clean": "rimraf ./node_modules dist",
    "check:lint": "biome check --write",
    "check:type": "tsc -p ./tsconfig.esm.json --noEmit",
    "check:dep": "depcruise --config .dependency-cruiser.mjs src"
  },
  "dependencies": {
    "@stackory/backend-platform": "workspace:*",
    "@stackory/utils": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j-xzy/stackory",
    "directory": "packages/backend/utils"
  }
}
