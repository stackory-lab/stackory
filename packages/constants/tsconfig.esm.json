{
	"extends": "@infra/tsconfig-presets/lib.esm.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "./dist/esm",
		"rootDir": "./src",
		"tsBuildInfoFile": "./dist/esm/.tsbuildinfo",
		"lib": ["ESNext"],
	},
	"include": ["./src"],
	"exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
