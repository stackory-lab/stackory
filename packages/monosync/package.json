{
  "name": "@stackory/monosync",
  "version": "1.2.3",
  "type": "module",
  "bin": {
    "monosync": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf ./node_modules dist",
    "check:test": "vitest --watch=false",
    "check:lint": "biome check --write",
    "check:type": "tsc -p ./tsconfig.json --noEmit",
    "check:dep": "depcruise --config .dependency-cruiser.mjs src"
  },
  "dependencies": {
    "semver": "7.8.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@types/semver": "7.7.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stackory-lab/stackory",
    "directory": "packages/monosync"
  }
}
